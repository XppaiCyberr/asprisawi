DISCORD_TOKEN=put-your-bot-token-here
CLIENT_ID=put-your-application-client-id-here

# Recommended while developing because guild commands update immediately.
# Leave empty to register global commands instead. When set, npm run register
# also clears global commands so old slash commands from previous scripts disappear.
GUILD_ID=put-your-test-server-id-here

# Optional. Comma-separated role IDs that can use slash commands.
# Leave empty to allow everyone who can see the commands.
# AUTHORIZED_ROLE_IDS=role-id,another-role-id

# Optional. Persistent per-server settings file.
# GUILD_SETTINGS_PATH=data/guild-settings.json

# Optional. Persistent per-server voice call time stats file for /rank.
# VOICE_STATS_PATH=data/voice-stats.json

# Optional. Comma-separated voice channel IDs that count for /rank.
# Default: 1501852386052931754
# VOICE_TRACKED_CHANNEL_IDS=1501852386052931754

# Optional. Required for /sawi AI questions.
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Required for automatic /tts chat reading.
# Enable Message Content Intent in the Discord Developer Portal before setting this to true.
# ENABLE_MESSAGE_CONTENT_INTENT=false

# Optional. Set to false only if you intentionally keep global commands while using GUILD_ID.
# CLEAR_GLOBAL_COMMANDS=true

# Optional. When registering global commands, list guild IDs here to clear old guild commands.
# CLEAR_GUILD_IDS=server-id,another-server-id

# Optional. The bot will use @ffmpeg-installer/ffmpeg by default.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# Optional but recommended by discord-player-youtube for better YouTube stability.
# Use a throwaway YouTube account cookie, not your personal account.
# YOUTUBE_COOKIE=

# Optional. Default Microsoft Edge TTS voice for automatic /tts.
# Use an Edge TTS ShortName, for example id-ID-ArdiNeural or en-US-AriaNeural.
# TTS_VOICE=id-ID-ArdiNeural

# Optional. Enable verbose Edge TTS connection logs.
# DEBUG_TTS=false

# Optional. Spotify links work without these when the anonymous token endpoint works.
# Set these for more reliable Spotify API access.
# DP_SPOTIFY_CLIENT_ID=
# DP_SPOTIFY_CLIENT_SECRET=
